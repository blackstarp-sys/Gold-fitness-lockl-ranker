# Database Configuration (PostgreSQL / Cloud SQL)
DATABASE_URL="postgres://user:password@host:5432/dbname?sslmode=require"
# Or individual connection parameters:
# SQL_HOST="localhost"
# SQL_USER="postgres"
# SQL_PASSWORD="your_password"
# SQL_DB_NAME="dhanus_gold_db"

# Server & Application Configuration
PORT=3000
APP_URL="https://www.dhanusgoldfitness.com"

# Google Business Profile OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="https://www.dhanusgoldfitness.com/api/google/callback"

# Google Gemini AI API Key (from aistudio.google.com)
GEMINI_API_KEY="AIzaSy..."

# Automated Background Jobs / Security
CRON_SECRET="your_custom_cron_security_token"

# Optional External Integrations
RANK_PROVIDER="your_rank_provider_api_key"
WHATSAPP_ACCESS_TOKEN="your_whatsapp_token"
VITE_GOOGLE_MAPS_API_KEY="AIzaSy..."
